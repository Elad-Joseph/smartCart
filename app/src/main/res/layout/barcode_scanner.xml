<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity=""
    android:padding="16dp">
    <ImageButton
        android:id="@+id/barcodeScannerToListDisplay"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_margin="20dp"
        android:layout_gravity="top|right"
        android:background="@drawable/baseline_arrow_back"
        android:backgroundTint="@color/black"/>

    <SurfaceView
        android:id="@+id/camera"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="55dp"/>

    <ImageButton
        android:id="@+id/btn_scan"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:background="@drawable/baseline_camera"
        android:backgroundTint="@color/black"
        android:layout_marginTop="80dp"
        android:layout_gravity="center_horizontal"
        />

    <ImageButton
        android:id="@+id/addNewProductButton"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:background="@drawable/baseline_add_circle_outline"
        android:backgroundTint="@color/black"
        android:layout_gravity="right"
        android:layout_marginRight="20dp"/>
</LinearLayout>